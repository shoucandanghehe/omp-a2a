{
	"name": "omp-a2a",
	"version": "0.1.0",
	"packageManager": "bun@1.3.14",
	"private": true,
	"description": "Anonymous realtime Agent chat for OMP: WebSocket Presence + persistent Project history",
	"type": "module",
	"omp": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"bin": {
		"omp-a2a-hub": "./src/hub/cli.ts"
	},
	"scripts": {
		"hub": "bun run src/hub/cli.ts",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"typecheck": "tsc --noEmit",
		"check": "biome ci --error-on-warnings . && bun run typecheck",
		"build:extension": "bun build src/extension.ts --outdir dist/extension --target bun --external '@oh-my-pi/*'",
		"build:hub": "bun build src/hub/cli.ts --outdir dist/hub --target bun",
		"build": "bun run build:extension && bun run build:hub",
		"audit": "bun audit --prod --audit-level=high",
		"smoke": "bun test && bun run scripts/smoke.ts && bun run scripts/smoke-hub.ts",
		"smoke:docker": "bun run scripts/smoke-docker.ts",
		"verify": "bun run check && bun run build && bun run smoke"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"dependencies": {
		"@oh-my-pi/omptype": "^18.0.8",
		"express": "^5.2.1",
		"ws": "^8.21.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@oh-my-pi/pi-coding-agent": "^17.2.11",
		"@types/bun": "1.3.14",
		"@types/express": "^5.0.6",
		"@types/ws": "^8.18.1",
		"typescript": "7.0.2"
	}
}
