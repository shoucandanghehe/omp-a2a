# Host-published port
OMP_A2A_HUB_PORT=4173

# Optional public URL override. Compose otherwise derives loopback from OMP_A2A_HUB_PORT.
# OMP_A2A_HUB_PUBLIC_URL=https://mesh.example.internal

# Local-process data directory; each Hub must use a different directory
OMP_A2A_HUB_DATA_DIR=/absolute/path/to/hub-data
